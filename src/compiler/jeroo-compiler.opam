opam-version: "2.0"
maintainer:   [ "benkonz@protonmail.com"
                "bdorn@unomaha.edu" ]
authors:      "Benjamin Konz"
homepage:     "http://jeroo.org"
bug-reports:  "https://gitlab.com/unomaha/jeroo/issues"
dev-repo:     "git+https://gitlab.com/unomaha/jeroo.git"
doc:          "https://gitlab.com/unomaha/jeroo/wikis/home"
              synopsis:     "Virtual package to install and configure the Jeroo Compiler JS lib"

build: [
  ["dune" "subst"]
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j1" "--no-buffer"]
]

depends: [
  "ocaml"                {>= "4.12.0"}
  "dune"                 {build & >= "2.9.0"}
  "menhir"               {>= "20210419"}
  "ppx_deriving"         {>= "5.2.1"}
  "js_of_ocaml-compiler" {>= "3.9.0"}
  "js_of_ocaml-ppx"      {>= "3.9.0"}
  "js_of_ocaml"          {>= "3.9.0"}
  "ounit"                {>= "2.2.4"}
]
